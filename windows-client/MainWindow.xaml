<Window x:Class="VPNSL.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPNSL 1.0.2"
        Width="660" Height="900" MinWidth="560" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
  <Grid Background="{StaticResource Bg}" Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="66"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="72"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryDark}" BorderBrush="{StaticResource Primary}" BorderThickness="1" Margin="0,0,12,0">
          <TextBlock Text="V" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="VPNSL" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Text}"/>
          <TextBlock Text="Windows • 1.0.2" FontSize="11" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="HeaderStatus" Text="Отключено" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Pages -->
    <Grid Grid.Row="1" Background="{StaticResource Bg}">
      <!-- Connection -->
      <Grid x:Name="ConnectionPage" Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel Margin="4,2,4,10">
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,12">
              <StackPanel>
                <Border Width="120" Height="120" CornerRadius="28" Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,8,0,18">
                  <Grid>
                    <Ellipse Width="76" Height="76" Fill="#23304A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="V" FontSize="54" FontWeight="Bold" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="ConnectionStatus" Text="Отключено" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="UptimeText" Text="00:00:00" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,18"/>
                <Button x:Name="ConnectButton" Content="Подключить" Height="54" Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" Margin="0"/>
              </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                  <TextBlock Text="МАСКИРОВКА" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="ObfsStatus" Text="audio" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimarySoft}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="3,0">
                <StackPanel>
                  <TextBlock Text="ХЕШИ" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="HashesStatus" Text="0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                  <TextBlock Text="РЕЖИМ" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Весь трафик" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Success}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="ВОРКЕРЫ" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="WorkersStatus" Text="18" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="ОТПРАВЛЕНО ↑" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="UpStatus" Text="0 B" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimarySoft}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="ПОЛУЧЕНО ↓" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="DownStatus" Text="0 B" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Success}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Tunnel settings -->
      <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel Margin="4,2,4,12">
            <TextBlock Text="Туннель" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Подключение" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Peer" Foreground="{StaticResource Muted}"/><TextBox x:Name="PeerBox" ToolTip="IP/домен и порт сервера"/>
                <TextBlock Text="Пароль подключения" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="PasswordBox"/>
                <TextBlock Text="Хеши VK" Foreground="{StaticResource Muted}"/><TextBox x:Name="VkHashesBox" AcceptsReturn="True" Height="76" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Параметры клиента" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Воркеры" Foreground="{StaticResource Muted}"/><TextBox x:Name="WorkersBox"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Транспорт TURN" Foreground="{StaticResource Muted}"/><ComboBox x:Name="TurnTransportBox"><ComboBoxItem Content="udp"/><ComboBoxItem Content="tcp_tls"/></ComboBox></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="TURN host (необязательно)" Foreground="{StaticResource Muted}"/><TextBox x:Name="TurnHostBox"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="TURN port" Foreground="{StaticResource Muted}"/><TextBox x:Name="TurnPortBox"/></StackPanel>
                </Grid>
                <TextBlock Text="SNI" Foreground="{StaticResource Muted}"/><TextBox x:Name="SniBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Маскировка" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ObfsBox"><ComboBoxItem Content="audio"/><ComboBoxItem Content="video"/><ComboBoxItem Content="none"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="VK auth" Foreground="{StaticResource Muted}"/><ComboBox x:Name="VkAuthBox"><ComboBoxItem Content="vkcalls"/><ComboBoxItem Content="captcha"/></ComboBox></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Captcha" Foreground="{StaticResource Muted}"/><ComboBox x:Name="CaptchaBox"><ComboBoxItem Content="auto"/><ComboBoxItem Content="rjs"/><ComboBoxItem Content="wv"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Fingerprint" Foreground="{StaticResource Muted}"/><ComboBox x:Name="FingerprintBox"><ComboBoxItem Content="chrome"/><ComboBoxItem Content="firefox"/></ComboBox></StackPanel>
                </Grid>
                <TextBlock Text="Client IDs" Foreground="{StaticResource Muted}"/><TextBox x:Name="ClientIdsBox"/>
                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Routing -->
      <Grid x:Name="RoutingPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <Grid Margin="4,2,4,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Маршрутизация" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Исключения и явные маршруты" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="По умолчанию весь IPv4-трафик идёт через VPNSL. Правило «Напрямую» исключает выбранный адрес или сеть из VPN и отправляет его через физическое подключение Windows. «Через VPNSL» явно закрепляет маршрут за туннелем." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
                <Border Background="#162A22" BorderBrush="#2D6550" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                  <TextBlock Text="FULL-TUNNEL IPv4 ВКЛЮЧЁН ПО УМОЛЧАНИЮ" Foreground="{StaticResource Success}" FontWeight="SemiBold"/>
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="RouteNameBox" Grid.Column="0" Margin="0,4,6,8" ToolTip="Подпись ресурса"/>
                  <TextBox x:Name="RouteCidrBox" Grid.Column="1" Margin="6,4,6,8" ToolTip="IPv4 или CIDR"/>
                  <ComboBox x:Name="RouteTargetBox" Grid.Column="2" Margin="6,4,0,8">
                    <ComboBoxItem Content="Напрямую" Tag="MOBILE"/>
                    <ComboBoxItem Content="Через VPNSL" Tag="VPNSL"/>
                  </ComboBox>
                </Grid>
                <Button Content="Добавить правило" Style="{StaticResource PrimaryButton}" Click="AddRoute_Click" Margin="0,0,0,6"/>
                <WrapPanel>
                  <Button Content="Загрузить .bat/.txt/.list" Click="ImportRoutes_Click" ToolTip="Загруженный файл получит направление, выбранное выше"/>
                  <Button Content="Выгрузить все маршруты (.bat)" Click="ExportRoutes_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Генератор BAT по имени сайта" FontWeight="SemiBold"/>
                <TextBlock Text="Найдите IPv4 сайта и затем импортируйте BAT как «Напрямую» или «Через VPNSL»." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="SiteBox" Grid.Column="0" Margin="0,4,6,4" ToolTip="chatgpt.com"/><Button Grid.Column="1" Content="Найти IPv4" Click="ResolveSite_Click"/></Grid>
                <TextBlock x:Name="SiteResultText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Button x:Name="SaveSiteBatButton" Content="Сохранить BAT сайта" Click="SaveSiteBat_Click" IsEnabled="False" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <ListBox x:Name="RoutesList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,4">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,11,0" Checked="RouteEnabled_Changed" Unchecked="RouteEnabled_Changed"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding RouteCountDisplay}" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource Muted2}" FontSize="11"/>
                        <TextBlock Text="{Binding EnabledDisplay}" Foreground="{StaticResource Muted}" FontSize="11"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Routes[0]}" Foreground="{StaticResource Muted2}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="{Binding TargetDisplay}" Tag="{Binding Id}" Click="ChangeRouteTarget_Click" Style="{StaticResource RouteTargetButton}"/>
                      <Button Content="Удалить" Tag="{Binding Id}" Click="DeleteRoute_Click" Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <!-- Server -->
      <Grid x:Name="ServerPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel Margin="4,2,4,12">
            <TextBlock Text="Установка на сервер" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Установка и удаление сервера VPNSL по SSH. В Windows-пакет входят серверные бинарники amd64, arm64 и armv7." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="SSH" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Адрес VPS" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshHostBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="SSH port" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshPortBox" Text="22"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="SSH user" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshUserBox" Text="root"/></StackPanel>
                </Grid>
                <TextBlock Text="SSH пароль" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="SshPasswordBox"/>
                <TextBlock Text="Приватный ключ (необязательно)" Foreground="{StaticResource Muted}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="SshKeyPathBox" Grid.Column="0" Margin="0,4,6,8"/><Button Grid.Column="1" Content="Выбрать…" Click="BrowseSshKey_Click"/></Grid>
                <TextBlock Text="Passphrase ключа" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="SshKeyPassphraseBox"/>
                <Button Content="Проверить SSH" Click="TestSsh_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="VPNSL Server" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Peer port" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerPeerPortBox" Text="46000"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Web port" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerWebPortBox" Text="46002"/></StackPanel>
                </Grid>
                <TextBlock Text="Основной пароль VPNSL" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="ServerMainPasswordBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Логин web-панели" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerWebLoginBox"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Пароль web-панели" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="ServerWebPasswordBox"/></StackPanel>
                </Grid>
                <CheckBox x:Name="ServerDockerBox" Content="Установить в Docker" Margin="0,8"/>
                <TextBlock x:Name="ServerDeployStatusText" Text="Готово" Foreground="{StaticResource Muted}" Margin="0,4"/>
                <ProgressBar x:Name="ServerProgress" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,4,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="InstallServerButton" Grid.Column="0" Content="Установить / переустановить" Style="{StaticResource PrimaryButton}" Click="InstallServer_Click"/>
                  <Button x:Name="UninstallServerButton" Grid.Column="1" Content="Удалить" Click="UninstallServer_Click" Style="{StaticResource DangerButton}"/>
                </Grid>
                <Button Content="Открыть web-панель" Click="OpenServerPanel_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Logs -->
      <Grid x:Name="LogsPage" Visibility="Collapsed" Background="{StaticResource Bg}" Margin="4,2,4,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="Логи" Style="{StaticResource SectionTitle}" Margin="0"/>
          <TextBlock Text="Журнал работы VPN, маршрутов и Wintun" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
          <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Foreground="#E2E7EF" Background="{StaticResource LogBg}" BorderThickness="0" Margin="0"/>
        </Border>
        <Button Grid.Row="2" Content="Очистить журнал" Click="ClearLogs_Click" HorizontalAlignment="Right" Margin="0,8,0,0"/>
      </Grid>

      <!-- Info -->
      <Grid x:Name="InfoPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel Margin="4,2,4,12">
            <TextBlock Text="Информация" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="VPNSL for Windows" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimarySoft}"/>
                <TextBlock Text="Версия 1.0.2" Foreground="{StaticResource Muted}" Margin="0,3,0,14"/>
                <TextBlock Text="Windows-адаптация VPNSL с full-tunnel IPv4 по умолчанию и корректирующими маршрутами «Напрямую» / «Через VPNSL». VPN-протокол и Rust-клиент сохранены на базе исходного проекта." TextWrapping="Wrap" LineHeight="20"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Разработчики" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Windows adaptation / UI" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="Sazhaev-IA" FontWeight="SemiBold" Foreground="{StaticResource PrimarySoft}"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Original project" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="amurcanov" FontWeight="SemiBold"/></Grid>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Source basis" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="github.com/amurcanov/csqtt" Foreground="{StaticResource PrimarySoft}"/></Grid>
                <TextBlock Text="Windows-версия создана на основе исходного проекта amurcanov/csqtt с адаптацией интерфейса, маршрутизации и упаковки под Windows." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock Text="Репозиторий Windows-версии" FontWeight="SemiBold"/>
                <TextBlock Text="Nakortanax/WDTTSL" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/>
                <Button Content="Открыть репозиторий Nakortanax/WDTTSL" Click="OpenRepo_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Navigation -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="14" Padding="5" Margin="0,12,0,0">
      <UniformGrid x:Name="NavBar" Rows="1" Columns="6">
        <Button Content="Подключение" Tag="connection" Click="Nav_Click" Style="{StaticResource NavButton}" Background="{StaticResource PrimaryDark}" Foreground="White" BorderBrush="{StaticResource Primary}"/>
        <Button Content="Туннель" Tag="settings" Click="Nav_Click" Style="{StaticResource NavButton}"/>
        <Button Content="Установка" Tag="server" Click="Nav_Click" Style="{StaticResource NavButton}"/>
        <Button Content="Маршруты" Tag="routing" Click="Nav_Click" Style="{StaticResource NavButton}"/>
        <Button Content="Логи" Tag="logs" Click="Nav_Click" Style="{StaticResource NavButton}"/>
        <Button Content="Инфо" Tag="info" Click="Nav_Click" Style="{StaticResource NavButton}"/>
      </UniformGrid>
    </Border>
  </Grid>
</Window>