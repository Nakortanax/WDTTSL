<Window x:Class="VPNSL.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPNSL 1.0.8" Width="640" Height="900" MinWidth="540" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="78"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16,8" Margin="0,0,0,10">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="VPNSL" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
          <TextBlock Text="  1.0.8 by Sazhaev-IA" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <TextBlock x:Name="HeaderStatus" Text="Отключено" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid x:Name="ConnectionPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10" HorizontalAlignment="Stretch">
            <Border Width="132" Height="132" CornerRadius="16" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,18,0,18">
              <Grid><TextBlock Text="V" FontSize="68" FontWeight="Bold" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
            </Border>
            <Button x:Name="ConnectButton" Content="Подключить" Height="52" Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" Margin="0,0,0,10"/>
            <TextBlock x:Name="ConnectionStatus" Text="Отключено" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4"/>
            <TextBlock x:Name="UptimeText" Text="00:00:00" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Маскировка" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock x:Name="ObfsStatus" Text="audio" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Хеши" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock x:Name="HashesStatus" Text="0" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Режим" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="Маршруты" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
              </Grid>
            </Border>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Воркеры" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock x:Name="WorkersStatus" Text="18" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="↑" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock x:Name="UpStatus" Text="0 B" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="↓" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock x:Name="DownStatus" Text="0 B" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10">
            <TextBlock Text="Туннель" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Peer" Foreground="{StaticResource Muted}"/><TextBox x:Name="PeerBox" ToolTip="IP/домен и порт сервера"/>
            <TextBlock Text="Пароль подключения" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="PasswordBox"/>
            <TextBlock Text="Хеши VK" Foreground="{StaticResource Muted}"/><TextBox x:Name="VkHashesBox" AcceptsReturn="True" Height="75" VerticalScrollBarVisibility="Auto"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Воркеры" Foreground="{StaticResource Muted}"/><TextBox x:Name="WorkersBox"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Транспорт TURN" Foreground="{StaticResource Muted}"/><ComboBox x:Name="TurnTransportBox"><ComboBoxItem Content="udp"/><ComboBoxItem Content="tcp_tls"/></ComboBox></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="TURN host (необязательно)" Foreground="{StaticResource Muted}"/><TextBox x:Name="TurnHostBox"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="TURN port" Foreground="{StaticResource Muted}"/><TextBox x:Name="TurnPortBox"/></StackPanel>
            </Grid>
            <TextBlock Text="SNI" Foreground="{StaticResource Muted}"/><TextBox x:Name="SniBox"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Маскировка" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ObfsBox"><ComboBoxItem Content="audio"/><ComboBoxItem Content="video"/><ComboBoxItem Content="none"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="VK auth" Foreground="{StaticResource Muted}"/><ComboBox x:Name="VkAuthBox"><ComboBoxItem Content="vkcalls"/><ComboBoxItem Content="captcha"/></ComboBox></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Captcha" Foreground="{StaticResource Muted}"/><ComboBox x:Name="CaptchaBox"><ComboBoxItem Content="auto"/><ComboBoxItem Content="rjs"/><ComboBoxItem Content="wv"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Fingerprint" Foreground="{StaticResource Muted}"/><ComboBox x:Name="FingerprintBox"><ComboBoxItem Content="chrome"/><ComboBoxItem Content="firefox"/></ComboBox></StackPanel>
            </Grid>
            <TextBlock Text="Client IDs" Foreground="{StaticResource Muted}"/><TextBox x:Name="ClientIdsBox"/>
            <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="RoutingPage" Visibility="Collapsed">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Маршрутизация" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Выбор приложений в Windows-версии отсутствует. Маршрутизация выполняется по IPv4/CIDR и загруженным файлам. По умолчанию используется обычная сеть; включённые правила VPNSL направляются в туннель." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
              <TextBox x:Name="RouteNameBox" Grid.Column="0" Margin="0,4,6,8" ToolTip="Подпись ресурса"/>
              <TextBox x:Name="RouteCidrBox" Grid.Column="1" Margin="6,4,6,8" ToolTip="IPv4 или CIDR"/>
              <ComboBox x:Name="RouteTargetBox" Grid.Column="2" Margin="6,4,0,8"><ComboBoxItem Content="VPNSL"/><ComboBoxItem Content="MOBILE"/></ComboBox>
            </Grid>
            <Button Content="Добавить маршрут" Style="{StaticResource PrimaryButton}" Click="AddRoute_Click"/>
            <WrapPanel Margin="0,4,0,8">
              <Button Content="Загрузить .bat/.txt/.list" Click="ImportRoutes_Click"/>
              <Button Content="Выгрузить все маршруты (.bat)" Click="ExportRoutes_Click"/>
            </WrapPanel>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Генератор BAT по имени сайта" FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="SiteBox" Grid.Column="0" Margin="0,4,6,4" ToolTip="chatgpt.com"/><Button Grid.Column="1" Content="Найти IPv4" Click="ResolveSite_Click"/></Grid>
                <TextBlock x:Name="SiteResultText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Button x:Name="SaveSiteBatButton" Content="Сохранить BAT сайта" Click="SaveSiteBat_Click" IsEnabled="False" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <ListBox x:Name="RoutesList" Grid.Row="1" Background="{StaticResource Bg}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,3">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" Checked="RouteEnabled_Changed" Unchecked="RouteEnabled_Changed"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Routes[0]}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Target, StringFormat='Сеть: {0}'}" Foreground="{StaticResource Primary}"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Сеть" Tag="{Binding Id}" Click="ChangeRouteTarget_Click"/><Button Content="Удалить" Tag="{Binding Id}" Click="DeleteRoute_Click"/></StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <Grid x:Name="ServerPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10">
            <TextBlock Text="Установка на сервер" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Установка и удаление сервера VPNSL 1.0.8 по SSH. В пакет Windows входят серверные бинарники для amd64, arm64 и armv7 из того же исходного кода 1.0.8." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="SSH" FontWeight="SemiBold"/>
                <TextBlock Text="Адрес VPS" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshHostBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="SSH port" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshPortBox" Text="22"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="SSH user" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshUserBox" Text="root"/></StackPanel>
                </Grid>
                <TextBlock Text="SSH пароль" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="SshPasswordBox"/>
                <TextBlock Text="Приватный ключ (необязательно)" Foreground="{StaticResource Muted}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="SshKeyPathBox" Grid.Column="0" Margin="0,4,6,8"/><Button Grid.Column="1" Content="Выбрать…" Click="BrowseSshKey_Click"/></Grid>
                <TextBlock Text="Passphrase ключа" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="SshKeyPassphraseBox"/>
                <Button Content="Проверить SSH" Click="TestSsh_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock Text="VPNSL" FontWeight="SemiBold"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Peer port" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerPeerPortBox" Text="46000"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Web port" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerWebPortBox" Text="46002"/></StackPanel>
                </Grid>
                <TextBlock Text="Основной пароль VPNSL" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="ServerMainPasswordBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Логин web-панели" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerWebLoginBox"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Пароль web-панели" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="ServerWebPasswordBox"/></StackPanel>
                </Grid>
                <CheckBox x:Name="ServerDockerBox" Content="Установить в Docker" Foreground="{StaticResource Text}" Margin="0,8"/>
                <TextBlock x:Name="ServerDeployStatusText" Text="Готово" Foreground="{StaticResource Muted}" Margin="0,4"/>
                <ProgressBar x:Name="ServerProgress" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,4,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="InstallServerButton" Grid.Column="0" Content="Установить / переустановить" Style="{StaticResource PrimaryButton}" Click="InstallServer_Click"/>
                  <Button x:Name="UninstallServerButton" Grid.Column="1" Content="Удалить" Click="UninstallServer_Click"/>
                </Grid>
                <Button Content="Открыть web-панель" Click="OpenServerPanel_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Логи" FontSize="20" FontWeight="SemiBold"/>
        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
        <Button Grid.Row="2" Content="Очистить" Click="ClearLogs_Click" HorizontalAlignment="Right"/>
      </Grid>

      <Grid x:Name="InfoPage" Visibility="Collapsed">
        <StackPanel Margin="10">
          <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
              <TextBlock Text="VPNSL for Windows" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
              <TextBlock Text="1.0.8 by Sazhaev-IA" Foreground="{StaticResource Muted}" Margin="0,4"/>
              <TextBlock Text="Windows-порт Android VPNSL 1.0.8. VPN-протокол и Rust-клиент сохранены. Выбор приложений намеренно не реализован; маршрутизация работает по IPv4/CIDR и файлам." TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Button Content="Открыть репозиторий Nakortanax/WDTTSL" Click="OpenRepo_Click" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,10,0,0">
      <UniformGrid Rows="1" Columns="6">
        <Button Content="Подключение" Tag="connection" Click="Nav_Click"/>
        <Button Content="Туннель" Tag="settings" Click="Nav_Click"/>
        <Button Content="Установка" Tag="server" Click="Nav_Click"/>
        <Button Content="Маршруты" Tag="routing" Click="Nav_Click"/>
        <Button Content="Логи" Tag="logs" Click="Nav_Click"/>
        <Button Content="Инфо" Tag="info" Click="Nav_Click"/>
      </UniformGrid>
    </Border>
  </Grid>
</Window>