# Copy to .env on the server. Do not commit real secrets.
SERVER_AI_DATA_DIR=/var/lib/server-ai
SERVER_AI_UID=1000
SERVER_AI_GID=1000

OLLAMA_CONTEXT_LENGTH=8192
QWEN_MODEL=qwen3.5:4b-q4_K_M
QWEN_THINK=false

AGENT_BIND_IP=192.168.1.73
AGENT_WEB_USER=igor
AGENT_WEB_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
AGENT_HISTORY_MESSAGES=24

# Optional until Telegram is enabled.
# Create a dedicated bot with @BotFather and keep its token only in server-ai/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
